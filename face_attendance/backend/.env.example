# FaceAttend Backend — Environment Configuration
# Copy this file to .env and adjust values as needed.

# ─── Face Recognition (InsightFace buffalo_l) ─────────────────────────────
# Cosine similarity threshold for face matching.
# buffalo_l (ArcFace R100) normalized embeddings scale: -1.0 to 1.0
# Same person: typically 0.35 – 0.75 | Different person: < 0.25
# Lower = more strict (fewer false positives, more false rejections)
FACE_SIMILARITY_THRESHOLD=0.35

# ─── Paths ────────────────────────────────────────────────────────────────
# Override the faces directory used by register_people.py
# FACES_DIR=./faces

# ─── API ──────────────────────────────────────────────────────────────────
# Used by register_people.py when backend is on another host
# API_BASE_URL=http://localhost:8000
